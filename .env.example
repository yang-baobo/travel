# 客户端只配置本平台 API 地址。Web 同域部署时可留空；原生 App 必填。
EXPO_PUBLIC_API_BASE_URL=

# 飞猪 FlyAI 官方 CLI Key，仅供服务端脚本/后端读取。
# 禁止使用 EXPO_PUBLIC_ 前缀，禁止提交真实值。
FLYAI_API_KEY=

# 高德 Web 服务 Key，只能配置在服务端，不要使用 JS API Key。
AMAP_WEB_SERVICE_KEY=

# 携程开放平台/联盟审核通过后，把官方落地页模板填到这里。
# 可用占位符：{name} {city} {adcode} {poi_id}
CTRIP_HOTEL_LINK_TEMPLATE=
CTRIP_TICKET_LINK_TEMPLATE=

# 餐饮合作方的官方落地页模板（当前允许美团/大众点评域名）。
# 可用占位符：{name} {city} {adcode} {poi_id}
MEITUAN_RESTAURANT_LINK_TEMPLATE=

# GLM 5.3 中转站（服务端变量，绝对不要使用 EXPO_PUBLIC_ 前缀）
# 兼容 OpenAI Chat Completions 时，通常填到 /v1 为止。
GLM_API_BASE_URL=
# 如果中转站给的是完整接口地址，可只填写这一项覆盖上面的拼接规则。
GLM_CHAT_COMPLETIONS_URL=
GLM_API_KEY=
GLM_MODEL=glm-5.3

# 阶跃星辰 StepAudio 2.5（一个 Key 同时用于 ASR 与 Realtime）
STEPFUN_API_KEY=
STEPFUN_API_BASE_URL=https://api.stepfun.com/v1
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
STEPFUN_REALTIME_MODEL=stepaudio-2.5-realtime
STEPFUN_REALTIME_VOICE=linjiajiejie

# 电话式实时语音使用 WebSocket。开发环境可填：
# ws://localhost:8000/api/ai/realtime
# 正式环境同域部署时可留空；也可以指向独立的 wss:// ASGI 服务。
EXPO_PUBLIC_REALTIME_WS_URL=
EXPO_PUBLIC_STEP_REALTIME_OUTPUT_SAMPLE_RATE=24000
